{
  "id": "./",
  "name": "Elimuhub — School Management (Demo)",
  "short_name": "Elimuhub",
  "description": "Try Elimuhub, the school management system for Kenyan schools, as a principal, bursar, teacher, parent or student. Works offline. A product of Pizza Technologies.",
