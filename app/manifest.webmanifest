    { "name": "Teacher: take the register", "short_name": "Register", "url": "./#/teacher/attendance", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Principal dashboard", "short_name": "Dashboard", "url": "./#/principal/home", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
